<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="TextEditor" Height="350" Width="500">

	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Margin" Value="5"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="White"/>
		</Style>
		<LinearGradientBrush x:Key="linearPanelBrush" StartPoint="0,0" EndPoint="1,0">
			<GradientStop Color="Yellow" Offset="0"/>
			<GradientStop Color="Aqua" Offset="0.5"/>
			<GradientStop Color="#FFDADA1A" Offset="1"/>
		</LinearGradientBrush>
	</Window.Resources>
	<Grid x:Name="grid1" Background="{StaticResource linearPanelBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition/>
		</Grid.RowDefinitions>
		<Border Grid.Row="0" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Margin="5">
			<StackPanel Orientation="Horizontal" Name="stack1">
				<Button Width="70" ToolTip="Відкрити..." Command="ApplicationCommands.Open">
					<Image Source="C:\Users\kanav\source\repos\Declarative-Programming-for-GUIs\images\open.png" Width="40" Height="40"/>
				</Button>
				<Button Width="70" ToolTip="Очистити" Command="ApplicationCommands.Delete">
					<Image Source="C:\Users\kanav\source\repos\Declarative-Programming-for-GUIs\images\delete.png" Width="40" Height="40"/>
				</Button>
				<Button Width="70" ToolTip="Копіювати" Command="ApplicationCommands.Copy">
					<Image Source="C:\Users\kanav\source\repos\Declarative-Programming-for-GUIs\images\copy.png" Width="40" Height="40"/>
				</Button>
				<Button Width="70" ToolTip="Вставити" Command="ApplicationCommands.Paste">
					<Image Source="C:\Users\kanav\source\repos\Declarative-Programming-for-GUIs\images\paste.png" Width="40" Height="40"/>
				</Button>
			</StackPanel>
		</Border>
		<Border Grid.Row="1" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Margin="5">
			<Grid Margin="10" Name="grid2">
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<TextBox Name="textBox1" Grid.Row="0" AcceptsTab="True" Margin="0,0,0,5"
                         TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Visible"
                         AcceptsReturn="True"/>
				<Button Grid.Row="1" Content="OK" Width="50" Height="25" HorizontalAlignment="Center"/>
			</Grid>
		</Border>
	</Grid>
</Window>


