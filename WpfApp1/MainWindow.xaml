<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="360" Width="600">

	<StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,50,0,0">

		<Label Content="Label" HorizontalAlignment="Center"/>

		<TextBox  Margin="0" Width="500" BorderThickness="0,1,0,1"  HorizontalAlignment="Stretch" Text="TextBox"/>
		<TextBox  Margin="0" Width="500" BorderThickness="0,1,0,1"  HorizontalAlignment="Stretch" Text="TextBox"/>
		<TextBox  Margin="0" Width="500" BorderThickness="0,1,0,1"  HorizontalAlignment="Stretch" Text="TextBox"/>
		<TextBox  Margin="0" Width="500" BorderThickness="0,1,0,1"  HorizontalAlignment="Stretch" Text="TextBox"/>

		<Button Content="Button" Width="200" Margin="0,60,0,0" HorizontalAlignment="Center"/>

	</StackPanel>
</Window>
