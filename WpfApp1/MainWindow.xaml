<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="TextEditor" Height="350" Width="500">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Border Grid.Row="0" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10">
			<StackPanel Orientation="Horizontal">
				<Button ToolTip="Відкрити">
					<Image Source="C:\Users\kanav\source\repos\Declarative-Programming-for-GUIs\images\open.png" Width="40" Height="40"/>
				</Button>
				<Button ToolTip="Стерти">
					<Image Source="C:\Users\kanav\source\repos\Declarative-Programming-for-GUIs\images\delete.png" Width="40" Height="40"/>
				</Button>
				<Button ToolTip="Копіювати">
					<Image Source="C:\Users\kanav\source\repos\Declarative-Programming-for-GUIs\images\copy.png" Width="40" Height="40"/>
				</Button>
				<Button ToolTip="Вставити">
					<Image Source="C:\Users\kanav\source\repos\Declarative-Programming-for-GUIs\images\paste.png" Width="40" Height="40"/>
				</Button>
			</StackPanel>
		</Border>
		<Border Grid.Row="1" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Margin="5">
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<TextBox Grid.Row="0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,0,0,5"/>
				<DockPanel Grid.Row="1" LastChildFill="False">
					<Button Content="OK" DockPanel.Dock="Bottom" Width="50" HorizontalAlignment="Center"/>
				</DockPanel>
			</Grid>
		</Border>
	</Grid>
</Window>

